{
  "name": "echopad",
  "productName": "Echopad",
  "version": "1.0.0",
  "description": "Echopad \u2014 a professional soundboard for Discord and voice chat",
  "author": "Echopad",
  "license": "MIT",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p .",
    "start": "vite build && electron .",
    "pack": "vite build && electron-builder --win --x64 --dir",
    "dist": "npm run typecheck && npm run pack && node scripts/build-installer.mjs",
    "icons": "node scripts/make-icons.js && node scripts/make-installer-art.js"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resedit": "^3.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "zustand": "^5.1.0"
  },
  "build": {
    "appId": "com.echopad.app",
    "productName": "Echopad",
    "copyright": "Copyright \u00a9 2026 Echopad",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "build/tray.png",
      "package.json"
    ],
    "asar": true,
    "afterPack": "scripts/afterPack.mjs",
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "electronLanguages": [
      "en-US"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/echopad/echopad.git"
  },
  "type": "commonjs"
}